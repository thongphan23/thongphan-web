{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thongphan-brain2-legacy-redirect",
  "main": "ops/brain2-legacy-redirect/_worker.js",
  "compatibility_date": "2026-07-12",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "brain2.thongphan.com/*",
      "zone_name": "thongphan.com"
    }
  ]
}
