      "kind": "prose",
      "children": [
        {
          "type": "text",
          "value": "🧭 Triết lý nền tảng"
        }
      ]
    },
    {
      "id": "day-01-block-05",
      "kind": "prose",
      "heading": "Bộ não sinh học không được thiết kế để nhớ — nó được thiết kế để suy nghĩ",
      "children": []
